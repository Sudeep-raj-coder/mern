<%- include('partials/header.ejs') %>

  <body class="bg-light">
    <!-- Main Container -->

    <div class="container py-5">

      <!-- Page Heading -->
      <div class="text-center mb-4">
        <h1 class="fw-bold text-primary">👤 View Contact</h1>
        <p class="text-muted">
          Show the contact details below
        </p>
      </div>
      <!-- Form Card -->
      <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
          <div class="card border-0 shadow-lg rounded-4">
            <!-- Card Header -->
            <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
              <h2 class="h5 mb-0">Contact Information</h2>
            </div>
            <!-- Card Body -->
            <div class="card-body p-4 p-md-5">

              <form action="/update-contact/<%= upcontact._id %>" method="POST">
                <!-- First Name & Last Name -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">First Name</label>
                    <input type="text" value="<%=upcontact.first_name %>" class="form-control form-control-lg"
                      name="first_name" readonly>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Last Name</label>
                    <input type="text" value="<%=upcontact.last_name %>" class="form-control form-control-lg"
                      name="last_name" placeholder="Enter last name" readonly>
                  </div>
                </div>
                <!-- Email -->
                <div class="mb-3">
                  <label class="form-label fw-semibold">Email Address</label>
                  <input type="text" value="<%=upcontact.email %>" class="form-control form-control-lg" name="email"
                    placeholder="example@gmail.com" readonly>
                  <div class="form-text">🔒 Your email will remain private.</div>
                </div>
                <!-- Phone -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Phone Number</label>
                  <input type="text" value="<%=upcontact.phone %>" class="form-control form-control-lg" name="phone"
                    placeholder="Enter phone number" readonly>
                </div>
                <div class="mb-4">
                  <label class="form-label fw-semibold">Address</label>
                  <input type="text" value="<%=upcontact.address %>" class="form-control form-control-lg" name="address"
                    placeholder="Enter phone number" readonly>
                </div>
                <!-- Buttons -->
                <div class="d-flex gap-2">
                  <button type="" class="btn btn-outline-secondary btn-lg">
                    <a href=" /update-contact/<%=upcontact.id  %> " class="text-decoration-none">📝 Edit</a>
                  </button>
                  <button type="reset" class="btn btn-outline-secondary btn-lg">
                    <a href="/" class="text-decoration-none"> ← Cancel</a>
                  </button>
                </div>
              </form>
            </div>
            <!-- Card Footer -->
            <div class="card-footer bg-white border-0 text-center py-3">
              <small class="text-muted">Add your contact details and click<strong>Save Contact</strong></small>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>



    <!-- Bootstrap JS -->
    <%- include('partials/footer.ejs') %>